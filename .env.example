NODE_ENV=production
PORT=5000

# Required
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-32+-char-random-secret

# optional (comma-separated list if multiple) dont put it 
CORS_ORIGIN=https://your-frontend-domain.com

# Admin seed user (used on startup if admin does not exist)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# HTTP hardening / limits
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
URL_ENCODED_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Cron controls
ENABLE_CRON=true
REMINDER_CRON_EXPRESSION=0 */12 * * *
CRON_TIMEZONE=Asia/Kolkata

# WhatsApp integration (optional; required only for WhatsApp features)
WHATSAPP_TOKEN=
TEST_NUM_ID=
WHATSAPP_NUM=
WHATSAPP_ACCOUNT_ID=
